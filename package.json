{
  "name": "jt-da-pa-memory",
  "version": "0.2.0",
  "description": "个人 AI 风格的跨会话记忆插件：记住关于你的事实（个性化画像），带出处与重要性/时间衰减打分；结合 dsh 定时服务的主动打扰；空闲时 dream 自动整理。零运行时依赖。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "记忆",
    "memory",
    "personal-ai",
    "long-term-memory",
    "proactive",
    "reminder",
    "dream",
    "consolidation"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
